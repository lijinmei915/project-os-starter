{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnidesk.local/schemas/project-overview-view-model.schema.json",
  "title": "Project Overview View Model",
  "type": "object",
  "required": ["schemaVersion", "projectId", "observedAt", "slots"],
  "properties": {
    "schemaVersion": { "const": "omnidesk.project-overview-view-model.v0.1" },
    "projectId": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string" },
    "slots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "render", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^project-overview\\." },
          "render": { "type": "boolean" },
          "state": {
            "type": "object",
            "required": ["freshness", "conflicts", "missing"],
            "properties": {
              "freshness": { "enum": ["fresh", "stale", "unknown"] },
              "conflicts": { "type": "array", "items": { "type": "string" } },
              "missing": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
