{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnidesk.local/schemas/project-fact-store.schema.json",
  "title": "OmniDesk Project Fact Store",
  "type": "object",
  "required": ["schemaVersion", "projectId", "observedAt", "facts"],
  "properties": {
    "schemaVersion": { "const": "omnidesk.project-fact-store.v0.1" },
    "projectId": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string" },
    "facts": {
      "type": "array",
      "items": { "$ref": "project-fact.schema.json" }
    }
  },
  "additionalProperties": false
}
