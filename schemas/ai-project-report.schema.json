{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-project-report.schema.json",
  "title": "AI Project Report Model",
  "description": "Machine-readable report module model for AI project engineering reports.",
  "type": "object",
  "required": ["modelId", "version", "modules"],
  "properties": {
    "modelId": {
      "type": "string",
      "description": "Stable report model identifier."
    },
    "version": {
      "type": "string",
      "description": "Report model version."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    },
    "description": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "sections", "help"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "help": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
