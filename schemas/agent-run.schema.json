{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnidesk.local/schemas/agent-run.schema.json",
  "title": "OmniDesk Agent Run",
  "type": "object",
  "required": ["schemaVersion", "id", "requestId", "conversationId", "taskId", "projectId", "executorId", "status", "step", "maxSteps", "attempt", "revision", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "omnidesk.agent-run.v0.1" },
    "id": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "conversationId": { "type": "string" },
    "taskId": { "type": "string" },
    "projectId": { "type": "string", "minLength": 1 },
    "executorId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["queued", "running", "awaiting-approval", "applying", "verifying", "succeeded", "failed", "cancelled", "interrupted"] },
    "step": { "type": "integer", "minimum": 0 },
    "maxSteps": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 0 },
    "revision": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "prompt": { "type": "string" },
    "approval": { "type": ["object", "null"] },
    "approvalToken": { "type": "string" },
    "summary": { "type": "string" },
    "repairAttempt": { "type": "integer", "minimum": 0 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "recordedAt"],
        "properties": {
          "phase": { "enum": ["draft", "approval", "apply", "check", "repair", "result"] },
          "recordedAt": { "type": "string", "format": "date-time" },
          "summary": { "type": "string" },
          "details": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
