{
  "schemaVersion": "project-os.file-contracts.v0.1",
  "contracts": [
    {
      "file": "PROJECT.md",
      "purpose": "记录项目当前阶段、架构、进度和下一步重点",
      "triggers": ["项目初始化", "阶段变化", "当前重点变化"],
      "requiredSections": ["项目定位", "当前架构", "当前进度", "下一步重点"],
      "forbidden": ["详细历史流水", "编造的进度"],
      "updatePolicy": "merge",
      "validation": ["bash scripts/check-runtime.sh ."]
    },
    {
      "file": "AGENTS.md",
      "purpose": "定义 AI 行为边界、路由和验证规则",
      "triggers": ["AI 行为变化", "路由变化", "禁止操作变化"],
      "requiredSections": ["Quick Start For Agents", "Commands", "Working Boundaries"],
      "forbidden": ["产品介绍", "长期路线图", "当前交接流水"],
      "updatePolicy": "merge",
      "validation": ["bash scripts/check-runtime.sh ."]
    },
    {
      "file": "HANDOFF.md",
      "purpose": "记录当前交接摘要、风险和下一步",
      "triggers": ["完成连续任务", "出现新风险", "准备交接"],
      "requiredSections": ["接手摘要", "最近完成", "风险与注意", "下一步建议"],
      "forbidden": ["长期路线图", "完整产品介绍"],
      "updatePolicy": "append-and-prune",
      "validation": ["bash scripts/check-runtime.sh ."]
    },
    {
      "file": "PRODUCT.md",
      "purpose": "记录产品定位、目标用户、核心价值和边界",
      "triggers": ["产品方向明确", "目标用户明确", "产品边界变化"],
      "requiredSections": ["产品定位", "目标用户", "核心价值", "产品边界"],
      "forbidden": ["未经证据支持的用户需求", "实现细节堆叠"],
      "updatePolicy": "merge",
      "validation": ["bash scripts/check-templates.sh"]
    },
    {
      "file": "docs/ARCHITECTURE.md",
      "purpose": "记录系统边界、模块职责、数据流和约束",
      "triggers": ["出现多个模块", "出现跨模块数据流", "架构边界变化"],
      "requiredSections": ["系统边界", "模块职责", "数据流", "已知约束"],
      "forbidden": ["不存在的服务", "无证据的技术选型"],
      "updatePolicy": "merge",
      "validation": ["bash scripts/check-runtime.sh ."]
    },
    {
      "file": "docs/ENVIRONMENT.md",
      "purpose": "记录环境、依赖、变量和启动方式",
      "triggers": ["出现环境变量", "出现启动命令", "出现环境差异"],
      "requiredSections": ["环境说明", "依赖", "环境变量", "启动方式"],
      "forbidden": ["真实密钥", "未经验证的命令"],
      "updatePolicy": "merge",
      "validation": ["bash scripts/check-secrets.sh .", "bash scripts/check-runtime.sh ."]
    },
    {
      "file": "docs/TESTING.md",
      "purpose": "记录测试范围、命令、验收标准和已知缺口",
      "triggers": ["出现测试命令", "开始验收", "出现回归风险"],
      "requiredSections": ["测试范围", "测试命令", "验收标准", "已知缺口"],
      "forbidden": ["未运行却声称通过", "无法执行的测试命令"],
      "updatePolicy": "merge",
      "validation": ["bash scripts/check-runtime.sh ."]
    },
    {
      "file": ".agents/skills/example-skill/SKILL.md",
      "purpose": "定义 Skill 触发条件、边界、工作流和验收",
      "triggers": ["出现可复用任务", "用户要求沉淀 Skill"],
      "requiredSections": ["触发条件", "边界", "工作流", "验收"],
      "forbidden": ["无触发条件的泛化能力", "未声明的危险副作用"],
      "updatePolicy": "create-or-merge",
      "generator": "index.html#GENERATED_RUNTIME_TEMPLATES",
      "validation": ["bash scripts/check-runtime.sh ."]
    }
  ]
}
