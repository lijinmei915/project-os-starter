{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-project-score.schema.json",
  "title": "AI Project Score Model",
  "description": "Machine-readable scoring model for AI project context completeness and engineering maturity.",
  "type": "object",
  "required": ["modelId", "version", "totalScores", "dimensions"],
  "properties": {
    "modelId": {
      "type": "string",
      "description": "Stable scoring model identifier."
    },
    "version": {
      "type": "string",
      "description": "Scoring model version."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    },
    "description": {
      "type": "string"
    },
    "totalScores": {
      "type": "object",
      "required": ["context", "maturity"],
      "properties": {
        "context": {
          "type": "integer",
          "minimum": 1
        },
        "maturity": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "statusBands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scoreType", "min", "label"],
        "properties": {
          "scoreType": {
            "type": "string",
            "enum": ["context", "maturity"]
          },
          "min": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "scoreType", "maxPoints", "checks"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "scoreType": {
            "type": "string",
            "enum": ["context", "maturity"]
          },
          "maxPoints": {
            "type": "integer",
            "minimum": 1
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label", "points", "detection"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "points": {
                  "type": "integer",
                  "minimum": 1
                },
                "gapLabel": {
                  "type": "string"
                },
                "detection": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "file_exists",
                        "substantive_file",
                        "substantive_file_any",
                        "dir_exists",
                        "content_any",
                        "substantive_content_any",
                        "state_stage_matches_project",
                        "script_supports_option",
                        "report_ui_inline_shell",
                        "manual"
                      ]
                    },
                    "path": {
                      "type": "string"
                    },
                    "paths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "patterns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "option": {
                      "type": "string"
                    },
                    "minMeaningfulLines": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "templatePath": {
                      "type": "string"
                    },
                    "forbiddenPatterns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "notes": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
