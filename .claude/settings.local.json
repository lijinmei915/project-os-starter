{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "last_commit=$(git log -1 --format=%ct 2>/dev/null || echo 0); claude_mod=$(stat -f %m CLAUDE.md 2>/dev/null || stat -c %Y CLAUDE.md 2>/dev/null || echo 0); [ \"$claude_mod\" -ge \"$last_commit\" ] || { echo '⚠️ CLAUDE.md 状态速览未更新！请先更新「当前状态速览」再 commit。'; exit 2; }",
            "statusMessage": "检查 CLAUDE.md 是否更新..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-dangerous-bash.sh",
            "statusMessage": "检查危险操作..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-protected-write.sh",
            "statusMessage": "检查文件写入权限..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-protected-write.sh",
            "statusMessage": "检查文件写入权限..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-showcase-sync.sh",
            "statusMessage": "检查 showcase ↔ docs 同步..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-new-component.sh",
            "statusMessage": "检查是否需要生成组件文档..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-showcase-sync.sh",
            "statusMessage": "检查 showcase ↔ docs 同步..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-new-component.sh",
            "statusMessage": "检查是否需要生成组件文档..."
          }
        ]
      }
    ]
  }
}
