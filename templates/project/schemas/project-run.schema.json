{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-os.project-run.schema.json",
  "title": "Project OS Run Record",
  "type": "object",
  "required": ["schemaVersion", "runId", "startedAt", "finishedAt", "target", "source", "status", "commands", "outputs", "next"],
  "properties": {
    "schemaVersion": {
      "const": "project-os.project-run.v0.1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["local", "git", "zip", "new"]
        },
        "uri": { "type": "string" }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["passed", "warning", "failed"]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "command", "exitCode", "logFile"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" },
          "logFile": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "object",
      "required": ["reportJson", "reportMarkdown", "recommendationsJson", "runRecord"],
      "properties": {
        "reportJson": { "type": "string" },
        "reportMarkdown": { "type": "string" },
        "recommendationsJson": { "type": "string" },
        "runRecord": { "type": "string" }
      },
      "additionalProperties": false
    },
    "next": {
      "type": "object",
      "required": ["summary", "requiresHumanConfirmation"],
      "properties": {
        "summary": { "type": "string" },
        "requiresHumanConfirmation": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
