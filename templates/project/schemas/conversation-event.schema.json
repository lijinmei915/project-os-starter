{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-os.local/schemas/conversation-event.schema.json",
  "title": "OmniDesk Conversation Event",
  "type": "object",
  "required": ["schemaVersion", "id", "type", "phase", "status", "actor", "requestId", "timestamp", "payload"],
  "properties": {
    "schemaVersion": { "const": "omnidesk.conversation-event.v0.1" },
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "enum": [
        "input.accepted",
        "context.loaded",
        "model.started",
        "model.delta",
        "action.proposed",
        "approval.required",
        "approval.resolved",
        "tool.started",
        "tool.progress",
        "tool.completed",
        "tool.failed",
        "request.progress",
        "request.completed",
        "request.failed",
        "request.cancelled"
      ]
    },
    "phase": { "enum": ["input", "thinking", "approval", "execution", "result"] },
    "status": { "enum": ["pending", "running", "completed", "failed", "cancelled"] },
    "actor": { "enum": ["user", "assistant", "system", "tool"] },
    "conversationId": { "type": "string" },
    "requestId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string" },
    "actionId": { "type": "string" },
    "sequence": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "detail": { "type": "string" },
        "outcome": { "type": "string" },
        "timeline": { "type": "array", "items": { "type": "object" } },
        "data": {}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
