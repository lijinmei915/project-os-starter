# Copy this file to .env.local and fill values locally.
# Never commit real API keys.

# Optional provider keys. The active connection is selected in OmniDesk Desktop.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
LLM_GATEWAY_API_KEY=

# Set to 1 only when running local repository checks without provider keys.
OMNIDESK_ALLOW_EMPTY_PROVIDER_KEYS=0
