# Copy this file to .env.local and fill values locally.
# Never commit real API keys.

# Optional AI provider keys.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
DASHSCOPE_API_KEY=
LLM_GATEWAY_API_KEY=

# Local development noise control.
# Set to 1 when you intentionally run pure local scans without provider keys.
PROJECT_OS_ALLOW_EMPTY_PROVIDER_KEYS=0

# Set to 1 to skip bitmap screenshot capture locally while keeping marker checks.
PROJECT_OS_SKIP_SCREENSHOT=0

# Generated artifact retention. Lower values keep local workspaces tidy.
PROJECT_OS_RETENTION_ENTRY_CONTEXTS=50
PROJECT_OS_RETENTION_RUNS=20
